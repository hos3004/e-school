{
    "name": "eschool/platform",
    "type": "project",
    "description": "Online School Management & Learning Platform - Laravel Modular Monolith",
    "keywords": [
        "laravel",
        "lms",
        "online-school",
        "modular-monolith"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.7",
        "guzzlehttp/guzzle": "^7.9",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/fortify": "^1.38",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.48",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.3.1",
        "predis/predis": "^2.2",
        "sentry/sentry-laravel": "^4.10",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^8.3",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^5.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
