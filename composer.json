            "Modules\\Payroll\\Database\\": "modules/Payroll/database/",
            "Modules\\Reporting\\Database\\": "modules/Reporting/database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Shared\\Tests\\": "shared/tests/",
            "Modules\\Identity\\Tests\\": "modules/Identity/tests/",
            "Modules\\AccessControl\\Tests\\": "modules/AccessControl/tests/",
            "Modules\\Organization\\Tests\\": "modules/Organization/tests/",
            "Modules\\Audit\\Tests\\": "modules/Audit/tests/",
            "Modules\\Integrations\\Tests\\": "modules/Integrations/tests/",
            "Modules\\Notifications\\Tests\\": "modules/Notifications/tests/",
            "Modules\\Students\\Tests\\": "modules/Students/tests/",
            "Modules\\Guardians\\Tests\\": "modules/Guardians/tests/",
            "Modules\\Staff\\Tests\\": "modules/Staff/tests/",
            "Modules\\Academics\\Tests\\": "modules/Academics/tests/",
            "Modules\\Groups\\Tests\\": "modules/Groups/tests/",
            "Modules\\Enrollments\\Tests\\": "modules/Enrollments/tests/",
            "Modules\\Content\\Tests\\": "modules/Content/tests/",
            "Modules\\Scheduling\\Tests\\": "modules/Scheduling/tests/",
            "Modules\\Sessions\\Tests\\": "modules/Sessions/tests/",
            "Modules\\Attendance\\Tests\\": "modules/Attendance/tests/",
            "Modules\\VirtualClassroom\\Tests\\": "modules/VirtualClassroom/tests/",
            "Modules\\Recordings\\Tests\\": "modules/Recordings/tests/",
            "Modules\\Assignments\\Tests\\": "modules/Assignments/tests/",
            "Modules\\Assessments\\Tests\\": "modules/Assessments/tests/",
            "Modules\\AcademicReports\\Tests\\": "modules/AcademicReports/tests/",
            "Modules\\Certificates\\Tests\\": "modules/Certificates/tests/",
            "Modules\\Discipline\\Tests\\": "modules/Discipline/tests/",
            "Modules\\Messaging\\Tests\\": "modules/Messaging/tests/",
            "Modules\\Billing\\Tests\\": "modules/Billing/tests/",
            "Modules\\Payroll\\Tests\\": "modules/Payroll/tests/",
            "Modules\\Reporting\\Tests\\": "modules/Reporting/tests/"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:arch": "pest --group=arch",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
