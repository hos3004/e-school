            "Modules\\Assessments\\": "modules/Assessments/src/",
            "Modules\\AcademicReports\\": "modules/AcademicReports/src/",
            "Modules\\Certificates\\": "modules/Certificates/src/",
            "Modules\\Discipline\\": "modules/Discipline/src/",
            "Modules\\Messaging\\": "modules/Messaging/src/",
            "Modules\\Billing\\": "modules/Billing/src/",
            "Modules\\Payroll\\": "modules/Payroll/src/",
            "Modules\\Reporting\\": "modules/Reporting/src/",
            "Modules\\Identity\\Database\\": "modules/Identity/database/",
            "Modules\\AccessControl\\Database\\": "modules/AccessControl/database/",
            "Modules\\Organization\\Database\\": "modules/Organization/database/",
            "Modules\\Audit\\Database\\": "modules/Audit/database/",
            "Modules\\Integrations\\Database\\": "modules/Integrations/database/",
            "Modules\\Notifications\\Database\\": "modules/Notifications/database/",
            "Modules\\Students\\Database\\": "modules/Students/database/",
            "Modules\\Guardians\\Database\\": "modules/Guardians/database/",
            "Modules\\Staff\\Database\\": "modules/Staff/database/",
            "Modules\\Academics\\Database\\": "modules/Academics/database/",
            "Modules\\Groups\\Database\\": "modules/Groups/database/",
            "Modules\\Enrollments\\Database\\": "modules/Enrollments/database/",
            "Modules\\Content\\Database\\": "modules/Content/database/",
            "Modules\\Scheduling\\Database\\": "modules/Scheduling/database/",
            "Modules\\Sessions\\Database\\": "modules/Sessions/database/",
            "Modules\\Attendance\\Database\\": "modules/Attendance/database/",
            "Modules\\VirtualClassroom\\Database\\": "modules/VirtualClassroom/database/",
            "Modules\\Recordings\\Database\\": "modules/Recordings/database/",
            "Modules\\Assignments\\Database\\": "modules/Assignments/database/",
            "Modules\\Assessments\\Database\\": "modules/Assessments/database/",
            "Modules\\AcademicReports\\Database\\": "modules/AcademicReports/database/",
            "Modules\\Certificates\\Database\\": "modules/Certificates/database/",
