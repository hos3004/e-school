###############################################################################
# APPLICATION
###############################################################################
APP_NAME="E-School"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=ar,en,fr
APP_MAINTENANCE_DRIVER=file

###############################################################################
# ORGANIZATION DEFAULTS  (see docs/01-PRD.md)
###############################################################################
ORG_NAME="أكاديمية"
ORG_DEFAULT_TIMEZONE=Africa/Cairo
ORG_DEFAULT_CURRENCY=EGP
ORG_WEEK_STARTS_ON=saturday

###############################################################################
# DATABASE  (PostgreSQL)
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eschool
DB_USERNAME=eschool
DB_PASSWORD=secret

###############################################################################
# CACHE / QUEUE / SESSION  (Redis)
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

HORIZON_PREFIX=eschool_horizon

###############################################################################
# BROADCASTING  (Laravel Reverb)
###############################################################################
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

###############################################################################
# VIRTUAL CLASSROOM  (provider-agnostic — see docs/11-provider-interfaces.md)
# Supported drivers in phase one: bigbluebutton | null
###############################################################################
CLASSROOM_PROVIDER=bigbluebutton
CLASSROOM_JOIN_WINDOW_BEFORE_MINUTES=10
CLASSROOM_JOIN_WINDOW_AFTER_MINUTES=15
CLASSROOM_AUTO_RECORD=true

BBB_BASE_URL=https://bbb.example.com/bigbluebutton/
BBB_SECRET=
BBB_WEBHOOK_SECRET=
BBB_MAX_CONCURRENT_MEETINGS=30

###############################################################################
# STORAGE
# Primary object storage = Cloudflare R2 (S3 compatible)
# Recording archive target = google_drive | r2 | none
###############################################################################
FILESYSTEM_DISK=r2

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eschool
R2_ENDPOINT=
R2_URL=

RECORDING_RETENTION_DAYS=30
RECORDING_ARCHIVE_DRIVER=google_drive
RECORDING_ALLOW_STUDENT_DOWNLOAD=false

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

###############################################################################
# MAIL  (Amazon SES)
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

###############################################################################
# NOTIFICATION CHANNELS
###############################################################################
NOTIFY_DEFAULT_CHANNELS=in_app,email
NOTIFY_QUIET_HOURS_START=22:00
NOTIFY_QUIET_HOURS_END=07:00
NOTIFY_MAX_RETRIES=5

WHATSAPP_ENABLED=false
WHATSAPP_MODE=outbound_only
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PASSWORD_RESET_TEMPLATE=password_reset_otp

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

###############################################################################
# FEATURE FLAGS  (see config/features.php)
###############################################################################
MODULE_PAYROLL_ENABLED=false
FEATURE_PAYROLL=false
FEATURE_STUDENT_BILLING=false
FEATURE_TEACHER_PAYOUTS=false
FEATURE_ASSIGNMENTS=true
FEATURE_ASSESSMENTS=true
FEATURE_CERTIFICATES=true
FEATURE_BADGES=true
FEATURE_MESSAGING=true
FEATURE_CLASS_WALL=true
FEATURE_PARENT_PORTAL=true
FEATURE_WEBINARS=true
FEATURE_MULTI_ORG=false

###############################################################################
# SECURITY
###############################################################################
ADMIN_2FA_REQUIRED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

###############################################################################
# OBSERVABILITY
###############################################################################
LOG_CHANNEL=stack
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
